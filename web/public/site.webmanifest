{
  "name": "Gitkut",
  "short_name": "Gitkut",
  "description": "A retro social profile for developers, powered by public GitHub data.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f9f9ff",
  "theme_color": "#a03b56",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
