{
  "name": "gitkut",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev:api": "pnpm --dir api dev",
    "dev:web": "pnpm --dir web dev",
    "build:api": "pnpm --dir api build",
    "build:web": "pnpm --dir web build",
    "build:web:prod": "NITRO_PRESET=cloudflare_pages NUXT_PUBLIC_API_URL=https://api.gitkut.com pnpm --dir web build",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "pnpm test:api && pnpm test:web",
    "test:api": "pnpm --dir api test",
    "test:web": "pnpm --dir web test",
    "typecheck:api": "pnpm --dir api typecheck",
    "typecheck:web": "pnpm --dir web typecheck",
    "deploy": "pnpm deploy:api",
    "deploy:api": "pnpm --dir api run deploy",
    "deploy:web": "pnpm --dir api exec wrangler pages deploy ../web/dist --project-name gitkut --branch main --commit-dirty=true",
    "db:migrations:local": "pnpm --dir api run db:migrations:apply:local",
    "db:migrations:remote": "pnpm --dir api run db:migrations:apply:remote",
    "storybook:web": "pnpm --dir web storybook",
    "build-storybook:web": "pnpm --dir web build-storybook"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
