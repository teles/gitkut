{
  "name": "gitkut-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "db:migrations:list": "wrangler d1 migrations list gitkut-db",
    "db:migrations:apply:local": "wrangler d1 migrations apply gitkut-db --local",
    "db:migrations:apply:remote": "wrangler d1 migrations apply gitkut-db --remote"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260510.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.50.0"
  }
}
